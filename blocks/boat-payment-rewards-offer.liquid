<div class="boat-payment-rewards-card" {{ block.shopify_attributes }}>
  <h4 class="boat-offers-heading">{{ block.settings.heading | default: 'Rewards and Payment Offers' }}</h4>
  <div class="boat-payment-reward-banner">
    <div class="boat-payment-reward-text">
      {{ block.settings.offer_text | default: 'Redeem upto 10% off additionally with boAt rewards' }}
    </div>
    <div class="boat-gift-icon-wrapper">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#e03131" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="20 12 20 22 4 22 4 12"></polyline>
        <rect x="2" y="7" width="20" height="5"></rect>
        <line x1="12" y1="22" x2="12" y2="7"></line>
        <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
        <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
      </svg>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "boAt Payment Rewards",
  "tag": "div",
  "class": "boat-payment-rewards-block",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Rewards and Payment Offers"
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "Offer Text",
      "default": "Redeem upto 10% off additionally with boAt rewards"
    }
  ],
  "presets": [
    {
      "name": "boAt Payment Rewards"
    }
  ]
}
{% endschema %}
