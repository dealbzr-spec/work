<script>
  // Global Dynamic Swatch Click Handler (Colors & Sizes)
  if (typeof selectBoatVariant !== 'function') {
    window.selectBoatVariant = function(dotBtn) {
      const card = dotBtn.closest('.boat-pick-card');
      if (!card) return;

      const allSwatches = card.querySelectorAll('.boat-swatch-dot, .boat-swatch-pill');
      allSwatches.forEach(d => d.classList.remove('active'));
      dotBtn.classList.add('active');

      const variantId = dotBtn.getAttribute('data-variant-id');
      const variantImage = dotBtn.getAttribute('data-variant-image');
      const variantPrice = dotBtn.getAttribute('data-variant-price');
      const variantCompare = dotBtn.getAttribute('data-variant-compare');
      const variantDiscount = dotBtn.getAttribute('data-variant-discount');
      const isAvailable = dotBtn.getAttribute('data-variant-available') === 'true';

      if (variantImage) {
        const img = card.querySelector('.boat-pick-card__image');
        if (img) img.src = variantImage;
      }

      const input = card.querySelector('input[name="id"]');
      if (input && variantId) input.value = variantId;

      const priceElem = card.querySelector('.boat-pick-card__price');
      if (priceElem && variantPrice) priceElem.textContent = variantPrice;

      const compareElem = card.querySelector('.boat-pick-card__compare-price');
      if (compareElem) {
        if (variantCompare) {
          compareElem.textContent = variantCompare;
          compareElem.style.display = 'inline';
        } else {
          compareElem.style.display = 'none';
        }
      }

      const discountElem = card.querySelector('.boat-pick-card__discount');
      if (discountElem) {
        if (variantDiscount && variantDiscount !== '0% off') {
          discountElem.textContent = variantDiscount;
          discountElem.style.display = 'inline';
        } else {
          discountElem.style.display = 'none';
        }
      }

      const submitBtn = card.querySelector('.boat-pick-card__hover-atc');
      if (submitBtn) {
        submitBtn.disabled = !isAvailable;
      }
    };
  }

  // Reverted to Robust Working Add to Cart Handler (Zero-Flicker Cart Sync)
  if (typeof handleBoatAddToCart !== 'function') {
    window.handleBoatAddToCart = async function(event, formElement) {
      event.preventDefault();
      const btn = formElement.querySelector('button[type="submit"]');
      if (!btn || btn.disabled) return;

      const originalHTML = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<span style="font-size:12px; font-weight:800; color:#fff;">...</span>';

      const formData = new FormData(formElement);

      const sectionIds = new Set(['cart-drawer-section']);
      document.querySelectorAll('cart-items-component').forEach(item => {
        if (item.dataset && item.dataset.sectionId) sectionIds.add(item.dataset.sectionId);
      });
      formData.append('sections', Array.from(sectionIds).join(','));

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          body: formData,
          headers: { 'Accept': 'application/json' }
        });

        const responseData = await response.json();

        if (response.ok && !responseData.status && !responseData.errors) {
          btn.style.background = '#16a34a';
          btn.innerHTML = '<span style="font-size:15px; font-weight:800; color:#fff;">✓</span>';

          const sections = responseData.sections || {};
          const drawerHtml = sections['cart-drawer-section'];

          if (drawerHtml) {
            const liveSection = document.getElementById('shopify-section-cart-drawer-section');
            if (liveSection) {
              const parser = new DOMParser();
              const doc = parser.parseFromString(drawerHtml, 'text/html');
              const newSection = doc.getElementById('shopify-section-cart-drawer-section');
              if (newSection) {
                const liveInner = liveSection.querySelector('.cart-drawer__inner');
                const newInner = newSection.querySelector('.cart-drawer__inner');

                if (liveInner && newInner) {
                  if (liveInner.classList.contains('cart-drawer--empty')) {
                    liveInner.replaceWith(newInner);
                  } else {
                    const liveItems = liveSection.querySelector('.cart-drawer__items');
                    const newItems = newSection.querySelector('.cart-drawer__items');
                    if (liveItems && newItems) {
                      liveItems.innerHTML = newItems.innerHTML;
                    }

                    const liveSummary = liveSection.querySelector('.cart-drawer__summary');
                    const newSummary = newSection.querySelector('.cart-drawer__summary');
                    if (liveSummary && newSummary) {
                      liveSummary.innerHTML = newSummary.innerHTML;
                    } else if (!liveSummary && newSummary) {
                      const contentContainer = liveSection.querySelector('.cart-drawer__content');
                      if (contentContainer) contentContainer.appendChild(newSummary);
                    }
                  }
                }
              }
            }
          }

          let itemCount = null;
          if (drawerHtml) {
            const countMatch = drawerHtml.match(/theme-drawer__badge[^>]*>\s*(\d+)/) || drawerHtml.match(/ref="cartItemCount"[^>]*>\s*(\d+)/);
            if (countMatch && countMatch[1]) {
              itemCount = parseInt(countMatch[1], 10);
            }
          }

          if (itemCount !== null) {
            const countElements = document.querySelectorAll('.cart-bubble__text-count, [ref="cartBubbleCount"], #cart-bubble-text, .cart-count-bubble, [data-cart-count], .theme-drawer__badge, .header-actions__cart-count');
            countElements.forEach(el => {
              el.classList.remove('hidden', 'visually-hidden');
              el.removeAttribute('hidden');
              el.textContent = itemCount;
            });

            const cartBubbles = document.querySelectorAll('.cart-bubble, [ref="cartBubble"], .cart-bubble-count, .cart-count-bubble, [data-cart-count]');
            cartBubbles.forEach(b => {
              if (itemCount > 0) {
                b.classList.remove('visually-hidden', 'hidden');
                b.removeAttribute('hidden');
                b.style.display = 'inline-flex';
                b.style.visibility = 'visible';
                b.style.opacity = '1';
              }
            });
          }

          (async () => {
            try {
              const cartRes = await fetch('/cart.js');
              const cartData = await cartRes.json();
              const finalCount = cartData.item_count;

              const detail = { cart: cartData, items: cartData.items, itemCount: finalCount, totalQuantity: finalCount, sections, didError: false };
              document.dispatchEvent(new CustomEvent('cart-lines-update', {
                bubbles: true,
                cancelable: true,
                detail: {
                  action: 'add',
                  context: 'product',
                  lines: [{ merchandiseId: formData.get('id'), quantity: Number(formData.get('quantity')) || 1 }],
                  promise: Promise.resolve({ cart: cartData, detail }),
                  ...detail
                }
              }));
              document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true, detail }));
              document.dispatchEvent(new CustomEvent('cart:updated', { bubbles: true, detail }));
            } catch(e) {
              console.warn('Background cart event sync failed', e);
            }
          })();

          setTimeout(() => {
            btn.disabled = false;
            btn.style.background = '';
            btn.innerHTML = originalHTML;
          }, 1500);

        } else {
          btn.disabled = false;
          btn.innerHTML = originalHTML;
        }
      } catch (err) {
        console.error('ATC Error:', err);
        btn.disabled = false;
        btn.innerHTML = originalHTML;
      }
    };
  }
</script>
